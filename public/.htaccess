<IfModule mod_headers.c>
  # Entry points — NEVER cache. index.html is ~2KB; always fetch fresh so a
  # deploy's new hashed bundles are picked up immediately. `no-cache` alone
  # allows 304 revalidation which can serve stale HTML if mtimes are off —
  # `no-store` eliminates that entire class of bug.
  <FilesMatch "^(index\.html|sw\.js)$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
  # Unhashed brand assets — revalidate every time (tiny files).
  <FilesMatch "^(icon\.svg|favicon\.svg|manifest\.webmanifest)$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  # Hashed build assets are immutable — cache for a year.
  <FilesMatch "\.[0-9a-f]{8}\.(js|css|woff2?|png|jpe?g|webp|svg)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # HSTS. Once a browser has seen this it will refuse to make a plaintext
  # request at all, which closes the window between the user typing http:// and
  # the 301 landing — over which an attacker could still tamper with the page.
  #
  # max-age is 1 year. includeSubDomains is deliberately set: shiarishta.com and
  # every subdomain are served by the same host and all redirect to https, so
  # there is no plaintext-only subdomain to break. NOT preload: that is an
  # irreversible, list-inclusion commitment and belongs as a separate, conscious
  # decision rather than a side effect of this fix.
  <IfModule mod_headers.c>
    Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains"
  </IfModule>
</IfModule>

# ── ShiaRishta SEO: canonical host + legacy cleanup + SPA fallback ──────────
# Serve the React app for "/". The old WordPress index.php is still on disk in
# public_html; without this, Apache's default DirectoryIndex can prefer it and
# serve the legacy WP homepage (placeholder text, old testimonials) at "/".
DirectoryIndex index.html
# Never show auto-generated directory listings (e.g. "Index of /blog/").
Options -Indexes
RewriteEngine On

# 1) Force HTTPS, then canonical host.
#
#    A security review flagged "redirect all traffic to HTTPS" as high priority
#    and it was correct for the APEX domain: http://shiarishta.com/ returned 200
#    and served the full page over plaintext. Only www happened to redirect, and
#    only because the www rule below fired first and its target was an https URL.
#    Bare http:// on the apex reached the origin unencrypted, which means a
#    network attacker could alter the HTML and the JS bundle before the browser
#    ever saw them.
#
#    %{HTTPS} is checked rather than assuming, so this works behind the shared
#    host's proxy. X-Forwarded-Proto is honoured ONLY for the two known hostnames
#    - trusting it from any source would let a client claim https and bypass the
#    redirect entirely.
RewriteCond %{HTTP_HOST} ^shiarishta\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://shiarishta.com%{REQUEST_URI} [R=301,L]

# www -> apex, permanent. One host = one copy of every page in the index, no
# split link equity between www and apex. Runs after the HTTPS redirect so a
# plaintext www request is upgraded before it is canonicalised.
RewriteCond %{HTTP_HOST} ^www\.shiarishta\.com$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://shiarishta.com%{REQUEST_URI} [R=301,L]
RewriteCond %{HTTP_HOST} ^www\.shiarishta\.com$ [NC]
RewriteRule ^ https://shiarishta.com%{REQUEST_URI} [R=301,L]

# Belt and braces: a modern client sending http:// with HSTS already cached will
# not reach us at all, but an explicit upgrade for API requests costs nothing and
# keeps logs free of plaintext hits.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP_HOST} ^(shiarishta\.com|www\.shiarishta\.com)$ [NC]
RewriteRule ^api/(.*)$ https://shiarishta.com/api/$1 [R=301,L]

# 2) Legacy WordPress URLs. The old WP install's routes no longer exist as
#    content. URLs that may carry backlink equity 301-redirect to the closest
#    new page so link value transfers instead of dying. Pure junk with no
#    equity (wp-* internals, feeds, author/category/tag archives) returns
#    410 Gone so crawlers drop them fast. None of these patterns collide with
#    real SPA routes (/profiles, /profile, /blog, /community, /api, ...).
#    NOTE: ^profile/ requires the trailing slash, so the SPA's /profile page
#    is untouched; same for ^members/ vs /profiles.
RewriteRule ^blog-post/ /blog [R=301,L]
RewriteRule ^user-story/ /success-stories [R=301,L]
RewriteRule ^testimonials/ /success-stories [R=301,L]
# Individual legacy WP post slugs found 404ing in Search Console (no backlink
# equity behind them, but a 301 to /blog beats a dead end for any visitor).
RewriteRule ^how-to-make-a-marriage-successful/?$ /blog [R=301,L]
RewriteRule ^rajab-the-most-blessed-month /blog [R=301,L]
# Sample pages are dead WP defaults — a 301 to /about reads as a soft 404
# (unrelated content), so they go 410 like the other WP leftovers.
RewriteRule ^sample-page/?$ - [G,L]
RewriteRule ^sample-page-2/?$ - [G,L]
RewriteRule ^terms-and-conditions /terms [R=301,L]
# /country/uk is an alias with no page of its own — send it to the canonical
# country page instead of serving a 200 with the homepage's meta.
RewriteRule ^country/uk/?$ /country/united-kingdom/ [R=301,L]
RewriteRule ^members/ /profiles [R=301,L]
RewriteRule ^profile/ /profiles [R=301,L]
RewriteRule ^20[0-9]{2}/[0-9]{2}/ /blog [R=301,L]
RewriteRule ^author/ - [G,L]
RewriteRule ^category/ - [G,L]
RewriteRule ^tag/ - [G,L]
RewriteRule ^members-2/?$ - [G,L]
# Dynamic sitemap — serves the full indexable URL set (static pages, blog
# posts, community posts, public profiles) from the API. Must come before the
# SPA fallback so /sitemap.xml never serves index.html.
RewriteRule ^sitemap\.xml$ api/sitemap.xml [L]
# Dynamic llms.txt — served from the live database (blog posts, cities,
# countries) so AI crawlers see everything, not just build-time content.
RewriteRule ^llms\.txt$ api/llms.txt [L]

RewriteRule ^comments/ - [G,L]
RewriteRule ^feed/?$ - [G,L]
RewriteRule ^wp-content/ - [G,L]
RewriteRule ^wp-includes/ - [G,L]
RewriteRule ^wp-admin - [G,L]
RewriteRule ^wp-login\.php$ - [G,L]
RewriteRule ^xmlrpc\.php$ - [G,L]
RewriteRule ^sitemap_index\.xml$ - [G,L]
RewriteRule ^wp-sitemap\.xml$ - [G,L]
RewriteRule ^wp-sitemap-posts- - [G,L]

# Dead URLs from Search Console (Sep 2026 crawls) — return 410 Gone so
# Google drops them fast instead of re-crawling the SPA fallback's 200.
# Without these, every junk URL serves index.html with a 200 status, which
# Google reads as duplicate homepage content (soft 404). One exception:
# /pages/guardian/ has a real destination (Guardians page), so it 301s.
RewriteRule ^pages/guardian/?$ /guardians [R=301,L]
RewriteRule ^pages/ - [G,L]
RewriteRule ^wordpress/ - [G,L]
RewriteRule ^pop/?$ - [G,L]
RewriteRule ^7349477/?$ - [G,L]
RewriteRule ^js/?$ - [G,L]
RewriteRule ^404-2/?$ - [G,L]
RewriteRule ^pricing\.html$ - [G,L]
RewriteRule ^google[0-9a-f]+\.html$ - [G,L]
RewriteRule \.md$ - [G,L]
RewriteRule ^package-lock\.json$ - [G,L]

# 3) ShiaRishta SPA — Apache fallback for client-side routes.
#    Every non-file request serves index.html so React Router can take over.
#    /blog/ is a real directory on disk (article images), so the !-d guard
#    would skip the fallback and expose the folder — route it explicitly.
#    NOTE: this must point at the PRERENDERED blog/index.html. Pointing it at
#    the root index.html (as it briefly did) made /blog serve the homepage.
RewriteRule ^blog/?$ blog/index.html [L]

# Blog post SSR — /blog/:slug serves a server-rendered article document
# (routes/blog-ssr.php) so crawlers receive the full article HTML in the
# first response instead of depending on client-side JavaScript. Without this,
# Google's renderer intermittently snapshots the SPA's 404 view and flags the
# post as a soft 404. Must come before the SPA fallback. Only matches
# single-segment slugs; /blog itself is handled above, and real files
# (article images under /blog/) are excluded by the !-f guard.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^blog/([a-z0-9-]+)/?$ api/blog-ssr/$1 [L]

# 4) Prerendered routes.
#    scripts/prerender-routes.mjs writes a real directory per public route
#    (dist/privacy/index.html and so on), so a crawler that never executes JS
#    receives that route's own H1, title and canonical instead of the
#    homepage's.
#
#    NO REWRITE IS NEEDED HERE, and adding one is actively dangerous:
#
#    * mod_dir's DirectorySlash (on by default) already 301s "/privacy" to
#      "/privacy/" and then serves privacy/index.html. The route works.
#
#    * A "strip the trailing slash" rule on top of that creates an infinite
#      loop: /privacy -> /privacy/ (DirectorySlash) -> /privacy (our rule) ->
#      forever. The page becomes unreachable for everyone, not just crawlers.
#      An earlier draft of this file had exactly that rule.
#
#    So the prerendered directories are served by DirectoryIndex and the
#    generic SPA fallback below still catches everything else.

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.html [L]
