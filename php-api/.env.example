APP_ENV=development
TZ=UTC
# ── Mail transport ───────────────────────────────────────────────────────────
# Leave MAIL_TRANSPORT blank and it resolves automatically:
#   SMTP_HOST set            -> smtp
#   APP_ENV=production       -> mail  (cPanel sendmail / mail() relay)
#   otherwise (development)  -> dev   (logged only, never delivered)
# Override with one of: smtp | mail | dev
#
# If you have NO SMTP credentials, that is fine — set APP_ENV=production and
# leave this blank. PHP mail() usually works on shared hosting with no setup.
# Verify it once after deploy:  /api/health plus a registration, then check
# cPanel → Email Accounts → Track Delivery, or grep the PHP error log for
# "[mail:mail] sent". NEVER leave a production site on `dev` — that silently
# discards every verification and password-reset link.
MAIL_TRANSPORT=
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# ── AI (NVIDIA NIM) ─────────────────────────────────────────────────────────
# The assistant and the admin content generator both call NVIDIA's OpenAI-
# compatible endpoint THROUGH THIS SERVER. The key is read with getenv() and is
# never sent to the browser, never bundled, and never logged.
#
# To enable: paste the key below and make sure php-api/.env is NOT committed
# (it is already in php-api/.gitignore). If NVIDIA_API_KEY is blank the assistant
# still answers — it falls back to the retrieved platform facts, so members are
# never left with a generic "ask support" reply.
NVIDIA_API_KEY=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
NVIDIA_MODEL=moonshotai/kimi-k3

# MariaDB/MySQL (cPanel: Database → MySQL Databases; DB_NAME/DB_USER are prefixed)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=shiarishta
DB_USER=shiarishta_user
DB_PASSWORD=
# >= 32 chars. Generate: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=change-me-to-a-long-random-secret-at-least-32-chars
# ≥ 32 random bytes, SEPARATE from JWT_SECRET so rotating one cannot orphan
# message history or ID uploads. Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Accepts 32-byte base64, 32-byte hex, or any passphrase (hashed to 32 bytes).
# If unset, a key is derived from JWT_SECRET for development — always set this
# explicitly in production. LOSE IT and every stored message and verification
# upload becomes permanently unreadable.
DATA_ENCRYPTION_KEY=
JWT_TTL=7d
CLIENT_URL=http://localhost:5173
# Comma-separated emails that become is_admin=true on register.
ADMIN_EMAILS=admin@shiarishta.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=ShiaRishta <no-reply@shiarishta.local>
# Keep OUTSIDE public_html — bytes are served only via admin-authenticated route.
UPLOAD_DIR=/home/username/shiarishta-uploads
# cPanel/nginx/LiteSpeed reverse proxy: 1 so rate limits see the real client IP.
TRUST_PROXY=1
# e2e runs only: set 1 to bypass the write limiter from localhost.
E2E_TEST_MODE=
