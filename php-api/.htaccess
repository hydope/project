# ShiaRishta PHP API — Apache front-controller config.
# Deploy target: public_html/api/ (served as https://shiarishta.com/api).
RewriteEngine On

# Never serve dotfiles over HTTP — most importantly .env (DB + JWT secrets).
<FilesMatch "^\.">
    Require all denied
</FilesMatch>

# ── Block direct access to internal source files ───────────────────────────
# Found by an audit of the live site: /api/lib/db.php returned 200 and
# /api/db/schema.sql shipped the entire schema. The rewrite below only forwards
# NON-file requests to index.php, so any real file inside /api/ was executable
# or downloadable by URL. That bypasses every privacy check in photoServe() and
# exposes DB/JWT internals.
#
# We block the internal DIRECTORIES rather than every .php on purpose: a blanket
# <FilesMatch "\.php$"> would also deny index.php, which is the front controller
# that serves the entire API.
#
# mod_rewrite ([F] -> 403) rather than RedirectMatch: in per-directory context
# the URL path arrives WITHOUT a leading slash, so a `^/(lib|...)/` pattern
# silently matched nothing and every file stayed reachable. The `^/?` keeps it
# correct either way.
# Public blog cover images (static marketing assets in uploads/blog-covers/)
# must stay directly reachable — every blog post's og:image, in-article
# <img>, and sitemap <image:image> points at them. Everything else under
# uploads/ (private user photos, served via photoServe()) stays blocked.
RewriteRule ^/?uploads/blog-covers/ - [L]

RewriteRule ^/?(?:lib|db|routes|tests|storage|uploads)/ - [F,L]

# Non-PHP source/data files must never be served either.
<FilesMatch "\.(sql|md|log|ini|lock|example|bak|old|dist|map)$">
    Require all denied
</FilesMatch>

# Defence in depth: the api tree should never be browsable as a listing.
Options -Indexes

# Route every non-file request through the front controller.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L]
